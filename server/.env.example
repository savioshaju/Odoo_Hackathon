# Copy this file to .env and set PGPASSWORD to your PostgreSQL password.
# .env must never be committed (add it to .gitignore before your first commit).

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# Databases are created by `npm run db:setup`
DB_NAME=loopledger
TEST_DB_NAME=loopledger_test

# GST: company state decides CGST+SGST (same state) or IGST (different state)
COMPANY_STATE=MH

PORT=4000
